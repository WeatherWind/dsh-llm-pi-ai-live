{
  "name": "dsh-llm-pi-ai-live",
  "version": "0.1.0",
  "description": "Real-time model-list refresh for DSH llm-pi-ai routes: queries each provider endpoint, merges the installed pi-ai catalog metadata onto the live ids, and appends new models through the official settings seam.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "llm-pi-ai",
    "model-catalog",
    "model-list",
    "cordis"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5",
    "@deepseek-ai/cordis-plugin-timer": ">=1.1.6 <2",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.2.0",
    "@earendil-works/pi-ai": ">=0.85.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-timer": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
